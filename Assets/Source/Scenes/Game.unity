  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: A hefty handful of gold. These 1.000 coins will give you a solid start.
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423\u0432\u0435\u0441\u0438\u0441\u0442\u0430\u044F \u0433\u043E\u0440\u0441\u0442\u043A\u0430
      \u0437\u043E\u043B\u043E\u0442\u0430. \u042D\u0442\u0438 1.000 \u043C\u043E\u043D\u0435\u0442
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0430\u0442 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0435
      \u043D\u0430\u0447\u0430\u043B\u043E."
    Object: {fileID: 0}
  - Language: Turkish
    Text: "Bir avu\xE7 dolusu alt\u0131n. Bu 1.000 jeton size sa\u011Flam bir ba\u015Flang\u0131\xE7
      \u200B\u200Bsa\u011Flayacak."
    Object: {fileID: 0}
