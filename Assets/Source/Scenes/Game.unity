  entries:
  - Language: English
    Text: 'Removing advertising when crossing between levels. '
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0423\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u043A\u043B\u0430\u043C\u0443
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043C\u0435\u0436\u0434\u0443
      \u0443\u0440\u043E\u0432\u043D\u044F\u043C\u0438. \u041D\u0430\u0432\u0441\u0435\u0433\u0434\u0430!"
    Object: {fileID: 0}
  - Language: Turkish
    Text: "Seviyeler aras\u0131nda ge\xE7erken reklamlar\u0131n kald\u0131r\u0131lmas\u0131."
    Object: {fileID: 0}
